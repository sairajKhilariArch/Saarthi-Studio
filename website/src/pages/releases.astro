---
  import BaseLayout from '../layouts/BaseLayout.astro';
  import Icon from '../components/Icon.astro';
  import PageHero from '../components/PageHero.astro';
  import { LATEST_RELEASE, LATEST_STABLE_RELEASE, RELEASES, formatBytes } from '../lib/releases';
  import { SITE } from '../lib/site';
---

<BaseLayout
  title="Releases — SAARTHI-STUDIO"
  description="Published SAARTHI-STUDIO releases, real downloadable assets, sizes, and release notes."
>
  <PageHero
    eyebrow="Releases"
    title="Release history"
    description="This list is generated from GitHub Releases. Only files actually attached to a published release are shown."
    breadcrumb={[{ label: 'Releases' }]}
  />

  <section class="section">
    <div class="container container-narrow">
      <div class="release-banner">
        <strong>Latest stable: {LATEST_STABLE_RELEASE.tag}</strong>
        <span class="release-meta">
          Latest downloadable: {LATEST_RELEASE.tag}
        </span>
        <a href={SITE.releases} target="_blank" rel="noopener noreferrer">All GitHub releases ↗</a>
      </div>

      {RELEASES.length ? (
        <div class="release-history">
          {RELEASES.map((release) => (
            <article class="release-card">
              <div class="release-card-header">
                <span class="release-card-tag">{release.tag}</span>
                <span class="release-card-date">
                  {release.date ? `Published ${release.date}` : 'Publication date unavailable'}
                </span>
              </div>
              <p class="release-card-body">
                {release.body.trim()
                  ? release.body
                  : 'No release notes were published. Open the GitHub release page for details.'}
              </p>
              <div class="release-meta">
                {release.assets.length} attached {release.assets.length === 1 ? 'asset' : 'assets'}
              </div>
              {release.assets.length > 0 && (
                <ul class="release-asset-list">
                  {release.assets.map((asset) => (
                    <li>
                      <a href={asset.url} target="_blank" rel="noopener noreferrer">{asset.name}</a>
                      <span>{formatBytes(asset.size)}</span>
                    </li>
                  ))}
                </ul>
              )}
              <a href={release.url} target="_blank" rel="noopener noreferrer">Release page ↗</a>
            </article>
          ))}
        </div>
      ) : (
        <div class="note-card">
          <Icon name="info" size={18} />
          <div>No published releases are available in the local manifest yet. Visit <a href={SITE.releases}>GitHub Releases</a>.</div>
        </div>
      )}

      <div class="note-card">
        <Icon name="shield" size={18} />
        <div>
          <strong>Verify before you install.</strong> When a release includes
          <code>SHA256SUMS.txt</code>, use it to verify the downloaded file.
          Releases without a checksum file are shown as published; this page
          does not invent or imply a checksum.
        </div>
      </div>
    </div>
  </section>
  <style>
    .release-card-header { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
    .release-asset-list { margin: 1rem 0; padding-left: 1.2rem; }
    .release-asset-list li { display: flex; justify-content: space-between; gap: 1rem; padding: .25rem 0; }
    .release-asset-list span { color: var(--muted, #777); white-space: nowrap; }
    .release-card-body { white-space: pre-wrap; overflow-wrap: anywhere; }
  </style>
</BaseLayout>
