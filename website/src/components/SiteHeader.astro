---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../lib/site';
import { withBase } from '../lib/url';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href.startsWith('/#')
    ? path === withBase('/')
    : path.startsWith(withBase(href));
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={withBase('/')} aria-label="Sarthi Studio home">
      <img
        class="brand-mark"
        src={withBase('/brand/logo.svg')}
        width="32"
        height="32"
        alt=""
        aria-hidden="true"
      />
      <span class="brand-name">Sarthi Studio</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        NAV.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="header-cta" href={withBase('/download/')}>
        <Icon name="download" size={15} />
        Download
      </a>
      <a
        class="icon-button header-github"
        href={SITE.repo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Sarthi Studio on GitHub"
        title="GitHub"
      >
        <Icon name="github" size={19} />
      </a>
      <ThemeToggle />
      <button
        class="icon-button menu-button"
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <Icon name="menu" size={20} class="menu-icon-open" />
        <Icon name="x" size={20} class="menu-icon-close" />
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav class="container" aria-label="Mobile navigation">
      {
        NAV.map((item) => (
          <a href={withBase(item.href)}>{item.label}</a>
        ))
      }
      <a href={SITE.repo} target="_blank" rel="noopener noreferrer">
        GitHub
        <Icon name="external" size={15} />
      </a>
    </nav>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  const setOpen = (open: boolean) => {
    if (!panel || !menuButton) return;
    panel.hidden = !open;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  if (menuButton && panel) {
    menuButton.addEventListener('click', () => setOpen(panel.hasAttribute('hidden')));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        menuButton.focus();
      }
    });

    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        setOpen(false);
      }
    });

    window.matchMedia('(min-width: 901px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
