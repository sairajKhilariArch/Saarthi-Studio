<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata for the AppImage and the .deb.

     appimagetool runs `appstreamcli validate-tree` over the whole AppDir and
     aborts the build when it exits non-zero. validate-tree treats a *warning*
     as failure, so the v1.26.5 run still died on:
       W: cid-desktopapp-is-not-rdns sarthi-studio
       I: content-rating-missing
     The component ID therefore has a real TLD and three dot-separated parts,
     the file name and the launchable desktop-id have to match that ID
     (metainfo-filename-cid-mismatch), and an OARS rating is declared. -->
<component type="desktop-application">
  <id>io.github.sairajkhilariarch.SarthiStudio</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Sarthi Studio</name>
  <summary>Local-first AI chat and coding workspace</summary>
  <developer id="io.github.sairajkhilariarch">
    <name>SAIRAJ KHILARI</name>
  </developer>
  <description>
    <p>
      Sarthi Studio runs a private HTTP service on your own machine and opens a
      browser UI for chat, code editing, agent runs and terminals. Chat requests
      are routed to a self-hosted FreeLLMAPI router or a local Ollama runtime;
      conversations, projects and settings stay in your home directory.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Multi-provider chat with token-budgeted context</li>
      <li>Workspace browsing, editing, search and git status</li>
      <li>Autonomous agent runs with approvals and checkpoints</li>
      <li>Real PTY terminals and bundled skills</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.sairajkhilariarch.SarthiStudio.desktop</launchable>
  <provides>
    <binary>free-ai-studio</binary>
  </provides>
  <url type="homepage">https://github.com/sairajKhilariArch/Saarthi-Studio</url>
  <url type="bugtracker">https://github.com/sairajKhilariArch/Saarthi-Studio/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>The chat workspace in its dark theme</caption>
      <image type="source">https://raw.githubusercontent.com/sairajKhilariArch/Saarthi-Studio/main/screenshots/local-ai-dark.png</image>
    </screenshot>
    <screenshot>
      <caption>Local runtime and hardware readout</caption>
      <image type="source">https://raw.githubusercontent.com/sairajKhilariArch/Saarthi-Studio/main/screenshots/local-ai-hardware.png</image>
    </screenshot>
  </screenshots>
  <categories>
    <category>Development</category>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>AI</keyword>
    <keyword>LLM</keyword>
    <keyword>chat</keyword>
    <keyword>code</keyword>
    <keyword>assistant</keyword>
  </keywords>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="3.50.1" date="2026-11-13"/>
    <release version="3.50.0" date="2026-11-13"/>
    <release version="3.49.0" date="2026-11-13"/>
    <release version="3.48.0" date="2026-11-13"/>
    <release version="3.47.0" date="2026-11-13"/>
    <release version="3.32.0" date="2026-11-13"/>
    <release version="1.26.6" date="2026-11-04"/>
  </releases>
</component>
